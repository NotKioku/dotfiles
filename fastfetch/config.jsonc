{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		"source": "~/.config/fastfetch/282.png",
		"type": "iterm",
		"width": 20,
		"preserveAspectRatio": true
	},
    "display": {
		"separator": "",
		"key": {
			"width": 10
		}
    },
    "modules": [
		"break",
        {
            "type": "title",
            "color": {
                "user": "magenta",
                "at": "white",
                "host": "magenta"
            }
        },
        "separator",
        {
            "type": "os",
            // "key": "",
			"key": "os",
            "keyColor": "red"
        },
		{
			"type": "wm",
			// "key": "",
			"key": "wm",
			"keyColor": "yellow"
		},
        {
            "type": "shell",
            // "key": "",
			"key": "sh",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            // "key": "",
			"key": "term",
            "keyColor": "cyan"
        },
		{
			"type": "custom",
			// "key": "",
			"key": "font",
			"keyColor": "blue",
			"format": "0xProto Nerd Font"
		},
		{
			"type": "terminalfont",
			// "key": "",
			"key": "font",
			"keyColor": "blue"
		},
		{
			"type": "uptime",
			// "key": "󰅐",
			"key": "up",
			"keyColor": "magenta"
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle"
		}
    ]
}
